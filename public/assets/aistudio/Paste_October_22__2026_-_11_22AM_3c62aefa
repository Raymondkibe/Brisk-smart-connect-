ackground:var(--wh3);color:var(--tx4)">4</div></div><div class="card" style="max-width:560px;margin:0 auto"><div id="wiz-1" class="wiz-step"><div class="card-title"><i class="fa-solid fa-router text-or"></i> Step 1 — What router do you have?</div><div class="g2" style="gap:.75rem;margin-bottom:1.5rem"><div class="feat-card text-center" style="cursor:pointer;padding:1rem" onclick="pickBrand('mikrotik',this)"><i class="fa-solid fa-router" style="font-size:1.5rem;color:var(--or);margin-bottom:.5rem;display:block"></i><div class="fw-7 text-sm">MikroTik</div><div class="text-xs text-su">✓ Full support</div></div><div class="feat-card text-center" style="cursor:pointer;padding:1rem" onclick="pickBrand('ubiquiti',this)"><i class="fa-solid fa-wifi" style="font-size:1.5rem;color:var(--or);margin-bottom:.5rem;display:block"></i><div class="fw-7 text-sm">Ubiquiti</div><div class="text-xs text-su">✓ Supported</div></div><div class="feat-card text-center" style="cursor:pointer;padding:1rem" onclick="pickBrand('tplink',this)"><i class="fa-solid fa-wifi" style="font-size:1.5rem;color:var(--or);margin-bottom:.5rem;display:block"></i><div class="fw-7 text-sm">TP-Link</div><div class="text-xs text-su">✓ Supported</div></div><div class="feat-card text-center" style="cursor:pointer;padding:1rem" onclick="pickBrand('other',this)"><i class="fa-solid fa-question" style="font-size:1.5rem;color:var(--tx4);margin-bottom:.5rem;display:block"></i><div class="fw-7 text-sm">Not Sure</div><div class="text-xs text-tx4">We'll help</div></div></div><button class="btn btn-primary btn-block" onclick="goStep(2)"><i class="fa-solid fa-arrow-right"></i> Next</button></div><div id="wiz-2" class="wiz-step" style="display:none"><div class="card-title"><i class="fa-solid fa-magnifying-glass text-or"></i> Step 2 — Find Your Router IP</div><div class="alert alert-info mb-4"><i class="fa-solid fa-lightbulb"></i><div class="text-sm">Not sure? Most routers use <strong>192.168.88.1</strong> (MikroTik) or <strong>192.168.1.1</strong> (others). Check the sticker on your router.</div></div><div class="form-group"><label class="form-label">Router IP Address *</label><input class="form-control" id="wz-ip" placeholder="192.168.88.1" style="font-size:1.1rem;text-align:center"></div><div class="flex gap-2"><button class="btn btn-ghost" onclick="goStep(1)"><i class="fa-solid fa-arrow-left"></i> Back</button><button class="btn btn-primary" style="flex:1" onclick="goStep(3)"><i class="fa-solid fa-arrow-right"></i> Next</button></div></div><div id="wiz-3" class="wiz-step" style="display:none"><div class="card-title"><i class="fa-solid fa-key text-or"></i> Step 3 — Router Login</div><div class="form-group"><label class="form-label">Username *</label><input class="form-control" id="wz-user" placeholder="admin" value="admin"></div><div class="form-group"><label class="form-label">Password *</label><input type="password" class="form-control" id="wz-pass" placeholder="Router password"></div><div class="form-group"><label class="form-label">Give it a name</label><input class="form-control" id="wz-name" placeholder="e.g. Home Router"></div><div class="flex gap-2"><button class="btn btn-ghost" onclick="goStep(2)"><i class="fa-solid fa-arrow-left"></i> Back</button><button class="btn btn-primary" style="flex:1" onclick="testAndNext()"><i class="fa-solid fa-plug"></i> Test & Continue</button></div><div id="wz-test-result" class="mt-3"></div></div><div id="wiz-4" class="wiz-step" style="display:none"><div class="card-title text-center"><i class="fa-solid fa-circle-check text-su" style="font-size:2rem;display:block;margin:0 auto .5rem"></i></div><h3 class="text-center fw-8 mb-2">Ready to Connect!</h3><div style="background:var(--wh2);border-radius:var(--rl);padding:1rem;margin-bottom:1.5rem" id="wz-summary"></div><button class="btn btn-primary btn-block btn-lg" onclick="finishWizard()"><i class="fa-solid fa-check"></i> Connect Router</button></div></div></div></div>
<script>
const API='/api',SITE=location.origin;
const Auth={
  token:()=>localStorage.getItem('bsc_token'),
  user:()=>{try{return JSON.parse(localStorage.getItem('bsc_user'))||null}catch{return null}},
  set:(t,u)=>{localStorage.setItem('bsc_token',t);localStorage.setItem('bsc_user',JSON.stringify(u))},
  clear:()=>{localStorage.removeItem('bsc_token');localStorage.removeItem('bsc_user')},
  ok:()=>!!localStorage.getItem('bsc_token'),
  role:()=>Auth.user()?.role||null,
  guard:(role)=>{
    if(!Auth.ok()){location.href='account.html?next='+encodeURIComponent(location.pathname);return false}
    if(role&&Auth.role()!==role){const r=Auth.role();location.href=r==='admin'?'admin-dashboard.html':r==='router_owner'?'owner-dashboard.html':'dashboard.html';return false}
    return true
  }
};
async function api(method,path,body=null,isForm=false){
  const opts={method,headers:{}};
  if(Auth.token())opts.headers['Authorization']='Bearer '+Auth.token();
  if(body&&!isForm){opts.headers['Content-Type']='application/json';opts.body=JSON.stringify(body)}
  else if(body&&isForm)opts.body=body;
  const r=await fetch(API+path,opts);const d=await r.json();
  if(!r.ok)throw new Error(d.message||'Request failed');
  return d
}
const Flash={
  _show(msg,type,icon){let c=document.getElementById('flash-container');if(!c){c=document.createElement('div');c.id='flash-container';c.className='flash-container';document.body.appendChild(c)}const el=document.createElement('div');el.className='flash flash-'+type;el.innerHTML='<i class="fa-solid fa-'+icon+'"></i><span>'+msg+'</span>';c.appendChild(el);setTimeout(()=>{el.style.opacity='0';el.style.transform='translateX(100%)';el.style.transition='.3s ease'},3200);setTimeout(()=>el.remove(),3500)},
  success:(m)=>Flash._show(m,'success','circle-check'),
  error:(m)=>Flash._show(m,'error','circle-xmark'),
  warning:(m)=>Flash._show(m,'warning','triangle-exclamation'),
  info:(m)=>Flash._show(m,'info','circle-info')
};
const Fmt={
  kes:(n)=>'KES '+Number(n||0).toLocaleString('en-KE'),
  num:(n)=>Number(n||0).toLocaleString(),
  k:(n)=>{const v=Number(n||0);return v>=1e6?(v/1e6).toFixed(1)+'M':v>=1000?(v/1000).toFixed(1)+'K':v.toString()},
  date:(d)=>d?new Date(d).toLocaleDateString('en-KE',{day:'numeric',month:'short',year:'numeric'}):'—',
  dt:(d)=>d?new Date(d).toLocaleString('en-KE',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}):'—',
  ago:(d)=>{if(!d)return'—';const s=Math.floor((Date.now()-new Date(d))/1000);if(s<60)return s+'s ago';if(s<3600)return Math.floor(s/60)+'m ago';if(s<86400)return Math.floor(s/3600)+'h ago';return Fmt.date(d)},
  init:(n)=>(n||'?').split(' ').map(p=>p[0]).join('').toUpperCase().slice(0,2),
  bytes:(b)=>{if(!b)return'0 B';const k=1024,s=['B','KB','MB','GB'];const i=Math.floor(Math.log(b)/Math.log(k));return parseFloat((b/Math.pow(k,i)).toFixed(1))+' '+s[i]},
  dur:(mins)=>{if(mins<60)return mins+'m';if(mins<1440)return(mins/60).toFixed(0)+'h';return Math.floor(mins/1440)+'d'}
};
function copyText(txt,lbl){navigator.clipboard.writeText(txt).then(()=>Flash.success((lbl||'Text')+' copied!')).catch(()=>{const ta=document.createElement('textarea');ta.value=txt;document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove();Flash.success((lbl||'Text')+' copied!')})}
function openModal(id){document.getElementById(id)?.classList.add('active')}
function closeModal(id){document.getElementById(id)?.classList.remove('active')}
document.addEventListener('click',e=>{
  if(e.target.classList.contains('modal-overlay'))e.target.classList.remove('active');
  const op=e.target.closest('[data-open]');if(op)openModal(op.dataset.open);
  const cl=e.target.closest('[data-close]');if(cl)closeModal(cl.dataset.close);
  document.querySelectorAll('.dropdown-menu.open').forEach(m=>{if(!m.closest('.dropdown').contains(e.target))m.classList.remove('open')});
  const dd=e.target.closest('[data-dd]');if(dd){const menu=document.getElementById(dd.dataset.dd)||dd.nextElementSibling;menu?.classList.toggle('open')}
});
function initTabs(){document.querySelectorAll('.tabs').forEach(tabsEl=>{const btns=tabsEl.querySelectorAll('.tab-btn');const container=tabsEl.closest('[data-tabs]')||tabsEl.parentElement;btns.forEach(btn=>{btn.addEventListener('click',()=>{btns.forEach(b=>b.classList.toggle('active',b===btn));container.querySelectorAll('.tab-pane').forEach(p=>p.classList.toggle('active',p.dataset.pane===btn.dataset.tab))})});container.querySelectorAll('.tab-pane').forEach((p,i)=>p.classList.toggle('active',i===0))})}
function initHamburger(){const hb=document.getElementById('hamburger'),mn=document.getElementById('mobile-nav');if(hb&&mn)hb.addEventListener('click',()=>{hb.classList.toggle('open');mn.classList.toggle('open')})}
window.addEventListener('scroll',()=>{document.querySelector('.navbar')?.classList.toggle('scrolled',window.scrollY>20)},{passive:true});
function renderNavUser(){const u=Auth.user();document.querySelectorAll('[data-nav-name]').forEach(el=>el.textContent=u?.name||'');document.querySelectorAll('[data-nav-av]').forEach(el=>{if(u?.avatar)el.innerHTML='<img src="'+u.avatar+'" style="width:100%;height:100%;object-fit:cover;border-radius:50%">';else el.textContent=Fmt.init(u?.name||'U')})}
function sbadge(s){const m={active:'badge-su',online:'badge-su',connected:'badge-su',completed:'badge-su',approved:'badge-su',resolved:'badge-su',deployed:'badge-su',live:'badge-su',inactive:'badge-er',offline:'badge-er',suspended:'badge-er',banned:'badge-er',rejected:'badge-er',failed:'badge-er',deleted:'badge-er',pending:'badge-wn',processing:'badge-wn',in_progress:'badge-wn',building:'badge-wn',expired:'badge-er',router_owner:'badge-info',admin:'badge-bk',customer:'badge-or',developer:'badge-pu',free:'badge-free',open:'badge-or',public:'badge-su',private:'badge-wn'};return '<span class="badge '+(m[s?.toLowerCase()]||'badge-or')+'">'+(s||'—')+'</span>'}
function renderPagination(containerId,total,page,limit,cbName){const el=document.getElementById(containerId);if(!el)return;const pages=Math.ceil(total/limit);if(pages<=1){el.innerHTML='';return}let html='<div class="flex gap-2 justify-center mt-4 flex-wrap">';if(page>1)html+='<button class="btn btn-ghost btn-sm" onclick="'+cbName+'('+(page-1)+')"><i class="fa-solid fa-chevron-left"></i></button>';for(let p=Math.max(1,page-2);p<=Math.min(pages,page+2);p++)html+='<button class="btn '+(p===page?'btn-primary':'btn-ghost')+' btn-sm" onclick="'+cbName+'('+p+')">' +p+'</button>';if(page<pages)html+='<button class="btn btn-ghost btn-sm" onclick="'+cbName+'('+(page+1)+')"><i class="fa-solid fa-chevron-right"></i></button>';html+='</div>';el.innerHTML=html}
function logout(){Auth.clear();location.href='index.html'}
// Chart helper
function mkChart(id,type,labels,datasets,opts={}){const el=document.getElementById(id);if(!el||typeof Chart==='undefined')return;try{new Chart(el,{type,data:{labels,datasets},options:{responsive:true,plugins:{legend:{display:datasets.length>1}},scales:type!=='pie'&&type!=='doughnut'?{y:{beginAtZero:true}}:undefined,...opts}})}catch(e){console.warn('Chart error:',e)}}
// QR Code helper
function mkQR(id,text,size=120){const el=document.getElementById(id);if(!el||typeof QRCode==='undefined')return;el.innerHTML='';try{new QRCode(el,{text,width:size,height:size,colorDark:'#0F172A',colorLight:'#ffffff',correctLevel:QRCode.CorrectLevel.M})}catch(e){console.warn('QR error:',e)}}
// Socket.IO helper (lazy)
let _socket=null;function getSocket(){if(!_socket&&typeof io!=='undefined'){_socket=io(API.replace('/api',''),{transports:['websocket','polling']});_socket.on('connect',()=>console.log('Socket connected'));_socket.on('disconnect',()=>console.log('Socket disconnected'))}return _socket}
document.addEventListener('DOMContentLoaded',()=>{initTabs();initHamburger();renderNavUser();
  // Slide-in observer
  const obs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){const all=Array.from(e.target.parentElement?.querySelectorAll('.slide-in-left-stagger')||[]);const idx=all.indexOf(e.target);setTimeout(()=>e.target.classList.add('visible'),idx*110);obs.unobserve(e.target)}})},{threshold:.12,rootMargin:'0px 0px -30px 0px'});
  document.querySelectorAll('.slide-in-left-stagger').forEach(el=>obs.observe(el));
  const p=new URLSearchParams(location.search);if(p.get('flash'))Flash[p.get('ft')||'info']?.(decodeURIComponent(p.get('flash')))
});

Auth.guard('router_owner');
let wizData={brand:'mikrotik'};
function pickBrand(b,el){wizData.brand=b;document.querySelectorAll('#wiz-1 .feat-card').forEach(c=>c.style.outline='none');el.style.outline='2.5px solid var(--or)'}
function goStep(n){
  for(let i=1;i<=4;i++){document.getElementById('wiz-'+i).style.display=i===n?'block':'none';const dot=document.getElementById('step-'+i);dot.style.background=i<=n?'var(--or)':'var(--wh3)';dot.style.color=i<=n?'#fff':'var(--tx4)'}
  if(n===4){wizData.ip=document.getElementById('wz-ip').value;wizData.user=document.getElementById('wz-user').value;wizData.name=document.getElementById('wz-name').value||'My Router';
    document.getElementById('wz-summary').innerHTML='<div class="flex justify-between text-sm mb-2"><span class="text-tx3">Router Name</span><span class="fw-6">'+wizData.name+'</span></div><div class="flex justify-between text-sm mb-2"><span class="text-tx3">Brand</span><span class="fw-6">'+wizData.brand+'</span></div><div class="flex justify-between text-sm"><span class="text-tx3">IP Address</span><span class="fw-6">'+wizData.ip+'</span></div>'}
}
async function testAndNext(){
  const ip=document.getElementById('wz-ip').value.trim(),user=document.getElementById('wz-user').value.trim(),pass=document.getElementById('wz-pass').value;
  if(!ip||!user||!pass){Flash.warning('Fill in all fields');return}
  wizData.pass=pass;
  const el=document.getElementById('wz-test-result');el.innerHTML='<div class="spinner-sm spinner"></div> Testing connection…';
  try{const d=await api('POST','/owner/test-router',{ip,brand:wizData.brand,username:user,password:pass});
  if(d.connected){el.innerHTML='<div class="alert alert-su"><i class="fa-solid fa-check"></i> Connected successfully!</div>';setTimeout(()=>goStep(4),800)}
  else{el.innerHTML='<div class="alert alert-er"><i class="fa-solid fa-xmark"></i> '+(d.message||'Could not connect. Check IP and password.')+'</div>'}
  }catch(e){el.innerHTML='<div class="alert alert-er"><i class="fa-solid fa-xmark"></i> '+e.message+'</div>'}
}
async function finishWizard(){
  try{const d=await api('POST','/owner/routers',{name:wizData.name,ip:wizData.ip,brand:wizData.brand,username:wizData.user,password:wizData.pass,connection_type:'direct'});Flash.success('🎉 Router connected! Redirecting…');setTimeout(()=>location.href='my-routers.html',1000)}catch(e){Flash.error(e.message)}
}
goStep(1);
</script>

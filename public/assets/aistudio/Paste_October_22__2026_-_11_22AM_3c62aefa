const API='/api',SITE=location.origin;
const Auth={
  token:()=>localStorage.getItem('bsc_token'),
  user:()=>{try{return JSON.parse(localStorage.getItem('bsc_user'))||null}catch{return null}},
  set:(t,u)=>{localStorage.setItem('bsc_token',t);localStorage.setItem('bsc_user',JSON.stringify(u))},
  clear:()=>{localStorage.removeItem('bsc_token');localStorage.removeItem('bsc_user')},
  ok:()=>!!localStorage.getItem('bsc_token'),
  role:()=>Auth.user()?.role||null,
  guard:(role)=>{
    if(!Auth.ok()){location.href='account.html?next='+encodeURIComponent(location.pathname);return false}
    if(role&&Auth.role()!==role){const r=Auth.role();location.href=r==='admin'?'admin-dashboard.html':r==='router_owner'?'owner-dashboard.html':'dashboard.html';return false}
    return true
  }
};
async function api(method,path,body=null,isForm=false){
  const opts={method,headers:{}};
  if(Auth.token())opts.headers['Authorization']='Bearer '+Auth.token();
  if(body&&!isForm){opts.headers['Content-Type']='application/json';opts.body=JSON.stringify(body)}
  else if(body&&isForm)opts.body=body;
  const r=await fetch(API+path,opts);const d=await r.json();
  if(!r.ok)throw new Error(d.message||'Request failed');
  return d
}

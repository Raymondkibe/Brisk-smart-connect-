<script>
const API='/api',SITE=location.origin;

// Auth helpers
const Auth={
  token:()=>localStorage.getItem('bsc_token'),
  user:()=>{try{return JSON.parse(localStorage.getItem('bsc_user'))||null}catch{return null}},
  set:(t,u)=>{localStorage.setItem('bsc_token',t);localStorage.setItem('bsc_user',JSON.stringify(u))},
  clear:()=>{localStorage.removeItem('bsc_token');localStorage.removeItem('bsc_user')},
  ok:()=>!!localStorage.getItem('bsc_token'),
  role:()=>Auth.user()?.role||null,
  guard:(role)=>{
    if(!Auth.ok()){location.href='account.html?next='+encodeURIComponent(location.pathname);return false}
    if(role&&Auth.role()!==role&&Auth.role()!=='admin'){
      const r=Auth.role();
      location.href=r==='admin'?'admin-dashboard.html':r==='router_owner'?'owner-dashboard.html':'dashboard.html';
      return false
    }
    return true
  }
};

// API fetch
async function api(method,path,body=null){
  const opts={method,headers:{}};
  if(Auth.token())opts.headers['Authorization']='Bearer '+Auth.token();
  if(body){opts.headers['Content-Type']='application/json';opts.body=JSON.stringify(body)}
  const r=await fetch(API+path,opts);
  const d=await r.json().catch(()=>({}));
  if(!r.ok)throw new Error(d.message||'Error '+r.status);
  return d
}

// Flash messages
const Flash={
  _s(m,t,ic){
    let c=document.getElementById('flash-wrap');
    if(!c){c=document.createElement('div');c.id='flash-wrap';c.className='flash-wrap';document.body.appendChild(c)}
    const el=document.createElement('div');el.className='flash flash-'+t;
    el.innerHTML='<i class="fa-solid fa-'+ic+'"></i><span>'+m+'</span>';
    c.appendChild(el);
    setTimeout(()=>{el.style.opacity='0';el.style.transform='translateX(110%)';el.style.transition='.3s ease'},3200);
    setTimeout(()=>el.remove(),3550)
  },
  success:m=>Flash._s(m,'success','circle-check'),
  error:m=>Flash._s(m,'error','circle-xmark'),
  warning:m=>Flash._s(m,'warning','triangle-exclamation'),
  info:m=>Flash._s(m,'info','circle-info')
};

// Formatting
const Fmt={
  kes:n=>'KES '+Number(n||0).toLocaleString('en-KE'),
  num:n=>Number(n||0).toLocaleString(),
  date:d=>d?new Date(d).toLocaleDateString('en-KE',{day:'numeric',month:'short',year:'numeric'}):'—',
  ago:d=>{if(!d)return'—';const s=Math.floor((Date.now()-new Date(d))/1e3);if(s<60)return s+'s ago';if(s<3600)return Math.floor(s/60)+'m ago';if(s<86400)return Math.floor(s/3600)+'h ago';if(s<604800)return Math.floor(s/86400)+'d ago';return Fmt.date(d)},
  init:n=>(n||'?').split(' ').map(p=>p[0]||'').join('').toUpperCase().slice(0,2),
  bytes:b=>{if(!b||b<1)return'0 B';const k=1024,s=['B','KB','MB','GB'];const i=Math.floor(Math.log(b)/Math.log(k));return parseFloat((b/Math.pow(k,i)).toFixed(1))+' '+s[i]}
};

// Status badge
function sbadge(s){
  const m={active:'badge-su',online:'badge-su',live:'badge-su',completed:'badge-su',approved:'badge-su',deployed:'badge-su',verified:'badge-su',
    offline:'badge-er',inactive:'badge-er',suspended:'badge-er',failed:'badge-er',cancelled:'badge-er',expired:'badge-er',rejected:'badge-er',
    pending:'badge-wn',on_job:'badge-info',in_progress:'badge-info',building:'badge-info',unused:'badge-or',redeemed:'badge-pu'};

}

// Copy text
function copyText(txt,label){
  navigator.clipboard.writeText(txt).then(()=>Flash.success((label||'Text')+' copied!')).catch(()=>{
    const el=document.createElement('textarea');el.value=txt;document.body.appendChild(el);el.select();document.execCommand('copy');el.remove();Flash.success((label||'Text')+' copied!')
  })
}

// QR Code
function mkQR(elId,text,size){
  const el=document.getElementById(elId);if(!el)return;el.innerHTML='';
  try{new QRCode(el,{text,width:size||110,height:size||110,colorDark:'#0F172A',colorLight:'#ffffff',correctLevel:QRCode.CorrectLevel.M})}
  catch{el.innerHTML='<div style="width:'+(size||110)+'px;height:'+(size||110)+'px;background:var(--wh2);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.7rem;color:var(--tx3)">QR</div>'}
}

// Chart
function mkChart(id,type,labels,data,label){
  const el=document.getElementById(id);if(!el)return null;
  const ctx=el.getContext('2d');
  return new Chart(ctx,{type,data:{labels,datasets:[{label:label||'',data,borderColor:'#F97316',backgroundColor:type==='line'?'rgba(249,115,22,.08)':'rgba(249,115,22,.75)',fill:type==='line',tension:.4,borderWidth:2.5,pointRadius:3,pointBackgroundColor:'#F97316'}]},options:{responsive:true,plugins:{legend:{display:false}},scales:{x:{grid:{display:false},ticks:{font:{size:10}}},y:{grid:{color:'rgba(0,0,0,.04)'},ticks:{font:{size:10}}}}}})};

// Modals
function openModal(id){const el=document.getElementById(id);if(el){el.classList.add('open');document.body.style.overflow='hidden'}}
function closeModal(id){const el=document.getElementById(id);if(el){el.classList.remove('open');document.body.style.overflow=''}}

// Sidebar toggle (mobile)
function toggleSidebar(){
  const sb=document.querySelector('.sidebar');
  const ov=document.querySelector('.sidebar-overlay');
  if(sb){sb.classList.toggle('sb-open');if(ov)ov.classList.toggle('open')}
}

// Init on DOM ready
document.addEventListener('DOMContentLoaded',()=>{
  // Flash container
  if(!document.getElementById('flash-wrap')){const c=document.createElement('div');c.id='flash-wrap';c.className='flash-wrap';document.body.appendChild(c)}

  // Close modals on overlay click / data-close
  document.addEventListener('click',e=>{
    if(e.target.classList.contains('modal-overlay'))closeModal(e.target.id);
    const btn=e.target.closest('[data-close]');if(btn)closeModal(btn.dataset.close);
  });

  // Sidebar overlay click → close
  document.querySelector('.sidebar-overlay')?.addEventListener('click',toggleSidebar);

  // Mobile menu toggle (public pages)
  const ham=document.getElementById('nav-ham');
  const menu=document.getElementById('mob-menu');
  if(ham&&menu){
    ham.addEventListener('click',()=>{ham.setAttribute('aria-expanded',menu.classList.toggle('open'));} );
    menu.addEventListener('click',e=>{if(e.target===menu)menu.classList.remove('open')});
  }

  // Tabs (data-tabs)
  document.querySelectorAll('[data-tabs]').forEach(container=>{
    const panes=container.querySelectorAll('[data-pane]');
    const btns=container.querySelectorAll('[data-tab]');
    btns.forEach(btn=>{
      btn.addEventListener('click',()=>{
        btns.forEach(b=>b.classList.remove('active'));
        panes.forEach(p=>p.classList.remove('active'));
        btn.classList.add('active');
        const t=container.querySelector('[data-pane="'+btn.dataset.tab+'"]');
        if(t)t.classList.add('active');
      });
    });
  });

  // Scroll nav shadow
  window.addEventListener('scroll',()=>{
    document.querySelector('.nav')?.classList.toggle('scrolled',window.scrollY>20)
  },{passive:true});

  // Scroll animations
  const obs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target)}})},{threshold:.1});
  document.querySelectorAll('.slide-up').forEach(el=>obs.observe(el));

  // App nav user info + logout
  const u=Auth.user();
  if(u){
    const nm=document.getElementById('nav-uname');const av=document.getElementById('nav-av');
    if(nm)nm.textContent=(u.name||'User').split(' ')[0];
    if(av)av.textContent=Fmt.init(u.name||'?');
  }
  document.getElementById('nav-logout')?.addEventListener('click',()=>{
    if(confirm('Sign out of BRISK?')){Auth.clear();location.href='index.html'}
  });

  // Active sidebar link
  const cur=location.pathname.split('/').pop()||'';
  document.querySelectorAll('.sb-link').forEach(a=>{
    const href=a.getAttribute('href')||'';
    if(href===cur||href===cur.replace('.html',''))a.classList.add('active');
  });

  // Active mobile bottom nav
  document.querySelectorAll('.mbn-item').forEach(a=>{
    const href=(a.getAttribute('href')||'').split('/').pop();
    if(href&&href===cur)a.classList.add('active');
  });
});
</script>
<script>
Auth.guard('router_owner');
let selBrandV = null;
const TIPS = {
  mikrotik: 'MikroTik selected. Enable API: WinBox → IP → Services → api → Enable (port 8728). Default IP: 192.168.88.1',
  tplink: 'TP-Link selected. API access is limited. You will need to set the IP to your router admin panel address.',
  huawei: 'Huawei selected. Basic monitoring only. Use the admin panel IP (usually 192.168.8.1).',
  other: 'Generic/OpenWrt router. API may not be available. BRISK will use basic connectivity.'
};
const DEFAULTS = { mikrotik: { ip: '192.168.88.1', port: '8728', user: 'admin' }, tplink: { ip: '192.168.0.1', port: '80', user: 'admin' }, huawei: { ip: '192.168.8.1', port: '80', user: 'admin' }, other: { ip: '192.168.1.1', port: '8728', user: 'admin' } };
const STEPS = { 1: { name: 'Choose Router Brand', pct: 25 }, 2: { name: 'Network Details', pct: 50 }, 3: { name: 'Hotspot Config', pct: 75 }, 4: { name: 'All Done!', pct: 100 } };
function goStep(n) {
  [1,2,3,4].forEach(i => { const el = document.getElementById('s'+i); if (el) el.style.display = i===n ? 'block' : 'none'; });
  document.getElementById('cur-step').textContent = n;
  document.getElementById('step-name').textContent = STEPS[n].name;
  document.getElementById('wiz-prog').style.width = STEPS[n].pct + '%';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
function selBrand(brand, el) {
  selBrandV = brand;
  document.querySelectorAll('.brand-card').forEach(c => { c.style.outline = 'none'; c.style.background = ''; });
  el.style.outline = '2.5px solid var(--or)'; el.style.background = 'rgba(249,115,22,.04)';
  const d = DEFAULTS[brand] || DEFAULTS.other;
  document.getElementById('r-ip').value = d.ip;
  document.getElementById('r-port').value = d.port;
  document.getElementById('r-user').value = d.user;
  const inst = document.getElementById('brand-instructions');
  inst.style.display = 'block';
  inst.innerHTML = `<div class="alert alert-info mb-4"><i class="fa-solid fa-circle-info"></i><div class="text-sm">${TIPS[brand]}</div></div>`;
  document.getElementById('s1-next').style.display = 'inline-flex';
}
async function testAndNext() {
  const ip = document.getElementById('r-ip').value.trim(), user = document.getElementById('r-user').value.trim();
  if (!document.getElementById('r-name').value.trim()) { Flash.warning('Router name required'); return; }
  if (!ip) { Flash.warning('IP address required'); return; }
  const btn = document.getElementById('test-btn'); btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Testing…';
  const res = document.getElementById('test-res'); res.style.display = 'block';
  res.innerHTML = '<div class="alert alert-info"><i class="fa-solid fa-plug"></i> Connecting to router…</div>';
  try {
    const d = await api('POST', '/owner/routers/test', { ip_address: ip, api_port: parseInt(document.getElementById('r-port').value) || 8728, api_username: user, api_password: document.getElementById('r-pass').value });
    res.innerHTML = `<div class="alert alert-su"><i class="fa-solid fa-circle-check"></i> Connected! RouterOS ${d.version || '7.x'} · ${d.model || 'MikroTik'}</div>`;
    // Set captive portal URL
    const slug = (Auth.user()?.business_slug || Auth.user()?.name?.toLowerCase().replace(/\s+/g,'-').replace(/[^a-z0-9-]/g,'') || 'my-router');
    document.getElementById('hs-url').value = `https://brisksmartconnect.vercel.app/portal.html?router=${slug}`;
    document.getElementById('pub-url-preview').textContent = `https://brisksmartconnect.vercel.app/@${slug}`;
    setTimeout(() => goStep(3), 1000);
  } catch(e) {
    res.innerHTML = `<div class="alert alert-er"><i class="fa-solid fa-xmark"></i> ${e.message}<br><span class="text-xs text-tx3">Check IP, port, username and that API is enabled on router</span></div>`;
  }
  btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-plug"></i> Test & Continue';
}
async function saveRouter() {
  const name = document.getElementById('r-name').value.trim();
  const ip = document.getElementById('r-ip').value.trim();
  const user = document.getElementById('r-user').value.trim();
  try {
    const d = await api('POST', '/owner/routers', {
      name, ip_address: ip,
      api_port: parseInt(document.getElementById('r-port').value) || 8728,
      api_username: user,
      api_password: document.getElementById('r-pass').value || '',
      hotspot_server: document.getElementById('r-hs').value || 'hotspot1',
      location: document.getElementById('r-loc').value,
      brand: selBrandV,
      ssid: document.getElementById('hs-ssid').value || 'BRISK_WIFI',
      idle_timeout: parseInt(document.getElementById('hs-idle').value) || 10,
      max_users: parseInt(document.getElementById('hs-max').value) || 50
    });
    const slug = Auth.user()?.business_slug || name.toLowerCase().replace(/\s+/g,'-').replace(/[^a-z0-9-]/g,'');
    document.getElementById('done-url').textContent = `https://brisksmartconnect.vercel.app/@${slug}`;
    document.getElementById('done-name').textContent = name;
    goStep(4);
  } catch(e) { Flash.error(e.message); }
}
// Auto-save when reaching step 4
const origGoStep = goStep;
window.goStep = function(n) {
  if (n === 4) { saveRouter(); return; }
  origGoStep(n);
};

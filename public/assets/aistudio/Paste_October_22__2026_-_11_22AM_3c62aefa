  kes:(n)=>'KES '+Number(n||0).toLocaleString('en-KE'),
  num:(n)=>Number(n||0).toLocaleString(),
  k:(n)=>{const v=Number(n||0);return v>=1e6?(v/1e6).toFixed(1)+'M':v>=1000?(v/1000).toFixed(1)+'K':v.toString()},
  date:(d)=>d?new Date(d).toLocaleDateString('en-KE',{day:'numeric',month:'short',year:'numeric'}):'—',
  dt:(d)=>d?new Date(d).toLocaleString('en-KE',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}):'—',
  ago:(d)=>{if(!d)return'—';const s=Math.floor((Date.now()-new Date(d))/1000);if(s<60)return s+'s ago';if(s<3600)return Math.floor(s/60)+'m ago';if(s<86400)return Math.floor(s/3600)+'h ago';return Fmt.date(d)},
  init:(n)=>(n||'?').split(' ').map(p=>p[0]).join('').toUpperCase().slice(0,2),
  bytes:(b)=>{if(!b)return'0 B';const k=1024,s=['B','KB','MB','GB'];const i=Math.floor(Math.log(b)/Math.log(k));return parseFloat((b/Math.pow(k,i)).toFixed(1))+' '+s[i]},
  dur:(mins)=>{if(mins<60)return mins+'m';if(mins<1440)return(mins/60).toFixed(0)+'h';return Math.floor(mins/1440)+'d'}
};
function copyText(txt,lbl){navigator.clipboard.writeText(txt).then(()=>Flash.success((lbl||'Text')+' copied!')).catch(()=>{const ta=document.createElement('textarea');ta.value=txt;document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove();Flash.success((lbl||'Text')+' copied!')})}
function openModal(id){document.getElementById(id)?.classList.add('active')}
function closeModal(id){document.getElementById(id)?.classList.remove('active')}
document.addEventListener('click',e=>{
  if(e.target.classList.contains('modal-overlay'))e.target.classList.remove('active');
  const op=e.target.closest('[data-open]');if(op)openModal(op.dataset.open);
  const cl=e.target.closest('[data-close]');if(cl)closeModal(cl.dataset.close);
  document.querySelectorAll('.dropdown-menu.open').forEach(m=>{if(!m.closest('.dropdown').contains(e.target))m.classList.remove('open')});
  const dd=e.target.closest('[data-dd]');if(dd){const menu=document.getElementById(dd.dataset.dd)||dd.nextElementSibling;menu?.classList.toggle('open')}
});
function initTabs(){document.querySelectorAll('.tabs').forEach(tabsEl=>{const btns=tabsEl.querySelectorAll('.tab-btn');const container=tabsEl.closest('[data-tabs]')||tabsEl.parentElement;btns.forEach(btn=>{btn.addEventListener('click',()=>{btns.forEach(b=>b.classList.toggle('active',b===btn));container.querySelectorAll('.tab-pane').forEach(p=>p.classList.toggle('active',p.dataset.pane===btn.dataset.tab))})});container.querySelectorAll('.tab-pane').forEach((p,i)=>p.classList.toggle('active',i===0))})}
function initHamburger(){const hb=document.getElementById('hamburger'),mn=document.getElementById('mobile-nav');if(hb&&mn)hb.addEventListener('click',()=>{hb.classList.toggle('open');mn.classList.toggle('open')})}
window.addEventListener('scroll',()=>{document.querySelector('.navbar')?.classList.toggle('scrolled',window.scrollY>20)},{passive:true});
function renderNavUser(){const u=Auth.user();document.querySelectorAll('[data-nav-name]').forEach(el=>el.textContent=u?.name||'');document.querySelectorAll('[data-nav-av]').forEach(el=>{if(u?.avatar)el.innerHTML='<img src="'+u.avatar+'" style="width:100%;height:100%;object-fit:cover;border-radius:50%">';else el.textContent=Fmt.init(u?.name||'U')})}
function sbadge(s){const m={active:'badge-su',online:'badge-su',connected:'badge-su',completed:'badge-su',approved:'badge-su',resolved:'badge-su',deployed:'badge-su',live:'badge-su',inactive:'badge-er',offline:'badge-er',suspended:'badge-er',banned:'badge-er',rejected:'badge-er',failed:'badge-er',deleted:'badge-er',pending:'badge-wn',processing:'badge-wn',in_progress:'badge-wn',building:'badge-wn',expired:'badge-er',router_owner:'badge-info',admin:'badge-bk',customer:'badge-or',developer:'badge-pu',free:'badge-free',open:'badge-or',public:'badge-su',private:'badge-wn'};return '<span class="badge '+(m[s?.toLowerCase()]||'badge-or')+'">'+(s||'—')+'</span>'}
function renderPagination(containerId,total,page,limit,cbName){const el=document.getElementById(containerId);if(!el)return;const pages=Math.ceil(total/limit);if(pages<=1){el.innerHTML='';return}let html='<div class="flex gap-2 justify-center mt-4 flex-wrap">';if(page>1)html+='<button class="btn btn-ghost btn-sm" onclick="'+cbName+'('+(page-1)+')"><i class="fa-solid fa-chevron-left"></i></button>';for(let p=Math.max(1,page-2);p<=Math.min(pages,page+2);p++)html+='<button class="btn '+(p===page?'btn-primary':'btn-ghost')+' btn-sm" onclick="'+cbName+'('+p+')">' +p+'</button>';if(page<pages)html+='<button class="btn btn-ghost btn-sm" onclick="'+cbName+'('+(page+1)+')"><i class="fa-solid fa-chevron-right"></i></button>';html+='</div>';el.innerHTML=html}
function logout(){Auth.clear();location.href='index.html'}
// Chart helper
function mkChart(id,type,labels,datasets,opts={}){const el=document.getElementById(id);if(!el||typeof Chart==='undefined')return;try{new Chart(el,{type,data:{labels,datasets},options:{responsive:true,plugins:{legend:{display:datasets.length>1}},scales:type!=='pie'&&type!=='doughnut'?{y:{beginAtZero:true}}:undefined,...opts}})}catch(e){console.warn('Chart error:',e)}}
// QR Code helper
function mkQR(id,text,size=120){const el=document.getElementById(id);if(!el||typeof QRCode==='undefined')return;el.innerHTML='';try{new QRCode(el,{text,width:size,height:size,colorDark:'#0F172A',colorLight:'#ffffff',correctLevel:QRCode.CorrectLevel.M})}catch(e){console.warn('QR error:',e)}}
// Socket.IO helper (lazy)
let _socket=null;function getSocket(){if(!_socket&&typeof io!=='undefined'){_socket=io(API.replace('/api',''),{transports:['websocket','polling']});_socket.on('connect',()=>console.log('Socket connected'));_socket.on('disconnect',()=>console.log('Socket disconnected'))}return _socket}
document.addEventListener('DOMContentLoaded',()=>{initTabs();initHamburger();renderNavUser();
  // Slide-in observer
  const obs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){const all=Array.from(e.target.parentElement?.querySelectorAll('.slide-in-left-stagger')||[]);const idx=all.indexOf(e.target);setTimeout(()=>e.target.classList.add('visible'),idx*110);obs.unobserve(e.target)}})},{threshold:.12,rootMargin:'0px 0px -30px 0px'});
  document.querySelectorAll('.slide-in-left-stagger').forEach(el=>obs.observe(el));
  const p=new URLSearchParams(location.search);if(p.get('flash'))Flash[p.get('ft')||'info']?.(decodeURIComponent(p.get('flash')))
});

Auth.guard('admin');
async function load(){
  try{const d=await api('GET','/admin/payment-methods');
  document.getElementById('pm-pend').textContent=Fmt.num(d.pending||0);
  document.getElementById('pm-act').textContent=Fmt.num((d.methods||[]).filter(m=>m.status==='active').length);
  document.getElementById('pm-owners').textContent=Fmt.num([...new Set((d.methods||[]).map(m=>m.owner_id))].length);
  document.getElementById('pm-table').innerHTML=(d.methods||[]).length
    ?'<div class="table-wrap"><table><thead><tr><th>Owner</th><th>Type</th><th>Number</th><th>Business</th><th>Status</th><th>Added</th><th>Action</th></tr></thead><tbody>'+(d.methods||[]).map(m=>'<tr><td><div class="fw-6 text-sm">'+(m.owner_name||'—')+'</div><div class="text-xs text-tx3">'+(m.phone||'—')+'</div></td><td><span class="badge badge-or">'+(m.label||m.type)+'</span></td><td class="fw-6 text-sm" style="font-family:monospace">'+(m.number||'—')+'</td><td class="text-sm">'+(m.business_name||'—')+'</td><td>'+sbadge(m.status)+'</td><td class="text-xs text-tx3">'+Fmt.ago(m.created_at)+'</td><td>'+(m.status==='pending'?'<button class="btn btn-su btn-sm" onclick="verify('+m.id+')"><i class="fa-solid fa-check"></i> Verify</button>':'')+'</td></tr>').join('')+'</tbody></table></div>'
    :'<div class="empty" style="padding:1.5rem"><div class="empty-icon"><i class="fa-solid fa-credit-card"></i></div><h3>No payment methods submitted yet</h3></div>';
  }catch(e){Flash.error(e.message)}
}
async function verify(id){try{await api('PUT','/admin/payment-methods/'+id+'/verify');Flash.success('Payment method verified and activated!');load()}catch(e){Flash.error(e.message)}}
load();
